{
  "openapi": "3.1.0",
  "info": {
    "title": "Prayer Timing API",
    "description": "A versioned REST API for calculating Islamic prayer timings using explicit location and timezone inputs.",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Service information",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Root  Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/prayer-times": {
      "get": {
        "tags": [
          "Prayer times"
        ],
        "summary": "Calculate prayer times and optional Azan adjustments",
        "description": "Calculate astronomical prayer times for the requested coordinates and date. The calculated_times values are never modified by Azan adjustments. The five *_adjustment parameters add or subtract whole minutes from the corresponding Azan time only. Sunrise and sunset cannot be adjusted.",
        "operationId": "get_prayer_times_api_v1_prayer_times_get",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "description": "Decimal latitude from -90 to 90.",
              "examples": [
                25.2048
              ],
              "title": "Latitude"
            },
            "description": "Decimal latitude from -90 to 90."
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "description": "Decimal longitude from -180 to 180.",
              "examples": [
                55.2708
              ],
              "title": "Longitude"
            },
            "description": "Decimal longitude from -180 to 180."
          },
          {
            "name": "timezone",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "IANA timezone, for example Asia/Dubai.",
              "examples": [
                "Asia/Dubai"
              ],
              "title": "Timezone"
            },
            "description": "IANA timezone, for example Asia/Dubai."
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Gregorian date. Defaults to today in the requested timezone.",
              "examples": [
                "2026-09-14"
              ],
              "title": "Date"
            },
            "description": "Gregorian date. Defaults to today in the requested timezone."
          },
          {
            "name": "calculation_method",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CalculationMethodName",
              "description": "Islamic prayer calculation method.",
              "examples": [
                "dubai"
              ]
            },
            "description": "Islamic prayer calculation method."
          },
          {
            "name": "madhab",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/MadhabName",
              "description": "Madhab used for Asr calculation.",
              "default": "shafi"
            },
            "description": "Madhab used for Asr calculation."
          },
          {
            "name": "high_latitude_rule",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/HighLatitudeRuleName",
              "description": "Rule used when high-latitude adjustments are required.",
              "default": "middle_of_the_night"
            },
            "description": "Rule used when high-latitude adjustments are required."
          },
          {
            "name": "fajr_adjustment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": -1440,
              "description": "Minutes added to Fajr Azan time. Sunrise is not adjustable.",
              "default": 0,
              "title": "Fajr Adjustment"
            },
            "description": "Minutes added to Fajr Azan time. Sunrise is not adjustable."
          },
          {
            "name": "dhuhr_adjustment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": -1440,
              "description": "Minutes added to Dhuhr Azan time.",
              "default": 0,
              "title": "Dhuhr Adjustment"
            },
            "description": "Minutes added to Dhuhr Azan time."
          },
          {
            "name": "asr_adjustment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": -1440,
              "description": "Minutes added to Asr Azan time.",
              "default": 0,
              "title": "Asr Adjustment"
            },
            "description": "Minutes added to Asr Azan time."
          },
          {
            "name": "maghrib_adjustment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": -1440,
              "description": "Minutes added to Maghrib Azan time.",
              "default": 0,
              "title": "Maghrib Adjustment"
            },
            "description": "Minutes added to Maghrib Azan time."
          },
          {
            "name": "isha_adjustment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": -1440,
              "description": "Minutes added to Isha Azan time.",
              "default": 0,
              "title": "Isha Adjustment"
            },
            "description": "Minutes added to Isha Azan time."
          }
        ],
        "responses": {
          "200": {
            "description": "Prayer times in the requested timezone, with immutable calculated times and separately adjusted Azan times.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrayerTimesResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request is valid but cannot be calculated.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_TIMEZONE",
                    "message": "Unknown IANA timezone: Not/ARealTimezone"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "One or more request parameters are invalid.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Request validation failed.",
                    "details": [
                      {
                        "field": "query.latitude",
                        "message": "Input should be less than or equal to 90",
                        "type": "less_than_equal"
                      }
                    ]
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/prayer-times/range": {
      "get": {
        "tags": [
          "Prayer times"
        ],
        "summary": "Calculate prayer times for an inclusive date range",
        "description": "Calculate each requested local calendar date independently using the existing prayer calculation engine. The range is inclusive and limited to 366 dates. Azan adjustments apply identically to every day and never modify calculated_times.",
        "operationId": "get_prayer_times_range_api_v1_prayer_times_range_get",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "description": "Decimal latitude from -90 to 90.",
              "title": "Latitude"
            },
            "description": "Decimal latitude from -90 to 90."
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "description": "Decimal longitude from -180 to 180.",
              "title": "Longitude"
            },
            "description": "Decimal longitude from -180 to 180."
          },
          {
            "name": "timezone",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "IANA timezone, for example Asia/Dubai.",
              "title": "Timezone"
            },
            "description": "IANA timezone, for example Asia/Dubai."
          },
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "First Gregorian date in the inclusive range.",
              "title": "Start Date"
            },
            "description": "First Gregorian date in the inclusive range."
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Last Gregorian date in the inclusive range.",
              "title": "End Date"
            },
            "description": "Last Gregorian date in the inclusive range."
          },
          {
            "name": "calculation_method",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CalculationMethodName",
              "description": "Islamic prayer calculation method."
            },
            "description": "Islamic prayer calculation method."
          },
          {
            "name": "madhab",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/MadhabName",
              "description": "Madhab used for Asr calculation.",
              "default": "shafi"
            },
            "description": "Madhab used for Asr calculation."
          },
          {
            "name": "high_latitude_rule",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/HighLatitudeRuleName",
              "description": "Rule used when high-latitude adjustments are required.",
              "default": "middle_of_the_night"
            },
            "description": "Rule used when high-latitude adjustments are required."
          },
          {
            "name": "fajr_adjustment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": -1440,
              "description": "Minutes added to Fajr Azan time.",
              "default": 0,
              "title": "Fajr Adjustment"
            },
            "description": "Minutes added to Fajr Azan time."
          },
          {
            "name": "dhuhr_adjustment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": -1440,
              "description": "Minutes added to Dhuhr Azan time.",
              "default": 0,
              "title": "Dhuhr Adjustment"
            },
            "description": "Minutes added to Dhuhr Azan time."
          },
          {
            "name": "asr_adjustment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": -1440,
              "description": "Minutes added to Asr Azan time.",
              "default": 0,
              "title": "Asr Adjustment"
            },
            "description": "Minutes added to Asr Azan time."
          },
          {
            "name": "maghrib_adjustment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": -1440,
              "description": "Minutes added to Maghrib Azan time.",
              "default": 0,
              "title": "Maghrib Adjustment"
            },
            "description": "Minutes added to Maghrib Azan time."
          },
          {
            "name": "isha_adjustment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": -1440,
              "description": "Minutes added to Isha Azan time.",
              "default": 0,
              "title": "Isha Adjustment"
            },
            "description": "Minutes added to Isha Azan time."
          }
        ],
        "responses": {
          "200": {
            "description": "Prayer times in chronological order for each requested local date, with immutable calculated times and separately adjusted Azan times.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrayerTimesRangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request is valid but cannot be calculated.",
            "content": {
              "application/json": {
                "examples": {
                  "invalid_date_range": {
                    "summary": "End date precedes start date",
                    "value": {
                      "error": {
                        "code": "INVALID_DATE_RANGE",
                        "message": "start_date must be on or before end_date"
                      }
                    }
                  },
                  "date_range_too_large": {
                    "summary": "More than 366 dates requested",
                    "value": {
                      "error": {
                        "code": "DATE_RANGE_TOO_LARGE",
                        "message": "Date range cannot exceed 366 days"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "One or more request parameters are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AzanTimesResponse": {
        "properties": {
          "fajr": {
            "type": "string",
            "title": "Fajr"
          },
          "dhuhr": {
            "type": "string",
            "title": "Dhuhr"
          },
          "asr": {
            "type": "string",
            "title": "Asr"
          },
          "maghrib": {
            "type": "string",
            "title": "Maghrib"
          },
          "isha": {
            "type": "string",
            "title": "Isha"
          }
        },
        "type": "object",
        "required": [
          "fajr",
          "dhuhr",
          "asr",
          "maghrib",
          "isha"
        ],
        "title": "AzanTimesResponse",
        "description": "Final Azan times after caller-supplied minute adjustments."
      },
      "CalculatedTimesResponse": {
        "properties": {
          "fajr": {
            "type": "string",
            "title": "Fajr"
          },
          "sunrise": {
            "type": "string",
            "title": "Sunrise"
          },
          "dhuhr": {
            "type": "string",
            "title": "Dhuhr"
          },
          "asr": {
            "type": "string",
            "title": "Asr"
          },
          "sunset": {
            "type": "string",
            "title": "Sunset"
          },
          "maghrib": {
            "type": "string",
            "title": "Maghrib"
          },
          "isha": {
            "type": "string",
            "title": "Isha"
          }
        },
        "type": "object",
        "required": [
          "fajr",
          "sunrise",
          "dhuhr",
          "asr",
          "sunset",
          "maghrib",
          "isha"
        ],
        "title": "CalculatedTimesResponse",
        "description": "Astronomically calculated prayer and solar-event times."
      },
      "CalculationMethodName": {
        "type": "string",
        "enum": [
          "muslim_world_league",
          "egyptian",
          "karachi",
          "umm_al_qura",
          "dubai",
          "iacad_dubai",
          "moon_sighting_committee",
          "north_america",
          "kuwait",
          "qatar",
          "singapore",
          "uoif"
        ],
        "title": "CalculationMethodName"
      },
      "CoordinatesResponse": {
        "properties": {
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "CoordinatesResponse",
        "description": "The geographic coordinates used for the calculation."
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "description": "A stable, machine-readable API error."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "example": {
          "error": {
            "code": "INVALID_TIMEZONE",
            "message": "Unknown IANA timezone: Asia/Invalid"
          }
        }
      },
      "HighLatitudeRuleName": {
        "type": "string",
        "enum": [
          "middle_of_the_night",
          "seventh_of_the_night",
          "twilight_angle"
        ],
        "title": "HighLatitudeRuleName"
      },
      "MadhabName": {
        "type": "string",
        "enum": [
          "shafi",
          "hanafi"
        ],
        "title": "MadhabName"
      },
      "PrayerAdjustmentsResponse": {
        "properties": {
          "fajr": {
            "type": "integer",
            "maximum": 1440,
            "minimum": -1440,
            "title": "Fajr"
          },
          "dhuhr": {
            "type": "integer",
            "maximum": 1440,
            "minimum": -1440,
            "title": "Dhuhr"
          },
          "asr": {
            "type": "integer",
            "maximum": 1440,
            "minimum": -1440,
            "title": "Asr"
          },
          "maghrib": {
            "type": "integer",
            "maximum": 1440,
            "minimum": -1440,
            "title": "Maghrib"
          },
          "isha": {
            "type": "integer",
            "maximum": 1440,
            "minimum": -1440,
            "title": "Isha"
          }
        },
        "type": "object",
        "required": [
          "fajr",
          "dhuhr",
          "asr",
          "maghrib",
          "isha"
        ],
        "title": "PrayerAdjustmentsResponse",
        "description": "Explicit Azan offsets supplied by the caller, in minutes."
      },
      "PrayerTimesRangeDayResponse": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date",
            "description": "Gregorian calculation date in the requested timezone."
          },
          "calculated_times": {
            "$ref": "#/components/schemas/CalculatedTimesResponse"
          },
          "azan_times": {
            "$ref": "#/components/schemas/AzanTimesResponse"
          }
        },
        "type": "object",
        "required": [
          "date",
          "calculated_times",
          "azan_times"
        ],
        "title": "PrayerTimesRangeDayResponse",
        "description": "Prayer times for one local date within a range response."
      },
      "PrayerTimesRangeResponse": {
        "properties": {
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "coordinates": {
            "$ref": "#/components/schemas/CoordinatesResponse"
          },
          "calculation_method": {
            "$ref": "#/components/schemas/CalculationMethodName"
          },
          "madhab": {
            "$ref": "#/components/schemas/MadhabName"
          },
          "high_latitude_rule": {
            "$ref": "#/components/schemas/HighLatitudeRuleName"
          },
          "adjustments_minutes": {
            "$ref": "#/components/schemas/PrayerAdjustmentsResponse"
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/PrayerTimesRangeDayResponse"
            },
            "type": "array",
            "title": "Days",
            "description": "Independently calculated days in chronological order, inclusive of both bounds."
          }
        },
        "type": "object",
        "required": [
          "start_date",
          "end_date",
          "timezone",
          "coordinates",
          "calculation_method",
          "madhab",
          "high_latitude_rule",
          "adjustments_minutes",
          "days"
        ],
        "title": "PrayerTimesRangeResponse",
        "description": "Stable v1 response for an inclusive range of local calendar dates.",
        "example": {
          "adjustments_minutes": {
            "asr": 0,
            "dhuhr": 0,
            "fajr": 0,
            "isha": 0,
            "maghrib": 0
          },
          "calculation_method": "dubai",
          "coordinates": {
            "latitude": 25.2048,
            "longitude": 55.2708
          },
          "days": [
            {
              "azan_times": {
                "asr": "15:43",
                "dhuhr": "12:17",
                "fajr": "04:47",
                "isha": "19:39",
                "maghrib": "18:25"
              },
              "calculated_times": {
                "asr": "15:43",
                "dhuhr": "12:17",
                "fajr": "04:47",
                "isha": "19:39",
                "maghrib": "18:25",
                "sunrise": "06:01",
                "sunset": "18:22"
              },
              "date": "2026-09-15"
            }
          ],
          "end_date": "2026-09-17",
          "high_latitude_rule": "middle_of_the_night",
          "madhab": "shafi",
          "start_date": "2026-09-15",
          "timezone": "Asia/Dubai"
        }
      },
      "PrayerTimesResponse": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date",
            "description": "Gregorian calculation date in the requested timezone."
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "description": "IANA timezone used for the calculation."
          },
          "coordinates": {
            "$ref": "#/components/schemas/CoordinatesResponse",
            "description": "Coordinates used for the calculation."
          },
          "calculation_method": {
            "$ref": "#/components/schemas/CalculationMethodName",
            "description": "Calculation method that was used."
          },
          "madhab": {
            "$ref": "#/components/schemas/MadhabName",
            "description": "Madhab used for the Asr calculation."
          },
          "high_latitude_rule": {
            "$ref": "#/components/schemas/HighLatitudeRuleName",
            "description": "High-latitude rule used for the calculation."
          },
          "calculated_times": {
            "$ref": "#/components/schemas/CalculatedTimesResponse",
            "description": "Prayer and solar-event times calculated by the astronomical engine. These values are not changed by Azan adjustments."
          },
          "azan_times": {
            "$ref": "#/components/schemas/AzanTimesResponse",
            "description": "Final Azan times after the caller's per-prayer minute adjustments. Sunrise and sunset are excluded because they are not Azan prayers."
          },
          "adjustments_minutes": {
            "$ref": "#/components/schemas/PrayerAdjustmentsResponse",
            "description": "Per-prayer Azan adjustments in minutes. Allowed prayers: Fajr, Dhuhr, Asr, Maghrib, and Isha. Sunrise and sunset cannot be adjusted. Range: -1440 to 1440."
          }
        },
        "type": "object",
        "required": [
          "date",
          "timezone",
          "coordinates",
